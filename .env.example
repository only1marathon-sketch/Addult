# Copy to .env and fill in. Never commit .env.
ENV=development                      # set to production when live
SECRET_KEY=change-me                 # long random string: python -c "import secrets;print(secrets.token_urlsafe(48))"
WORKER_TOKEN=change-me-worker-token  # another long random string
DATABASE_URL=sqlite:///./data/app.db # use Postgres in production

IMAGE_WORKER_URL=http://image-worker:8001
BASE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
CHAT_API_URL=http://chat:8000/v1
CHAT_MODEL=mistralai/Mistral-7B-Instruct-v0.3
HF_TOKEN=
CHAT_GPU_MEM=0.55                    # share of GPU memory for chat (0.9 if chat has its own GPU)

# Safety. The app refuses to start in production while these are "none".
AGE_VERIFICATION_PROVIDER=none       # veriff | yoti | ...
AGE_VERIFICATION_API_KEY=
IMAGE_SAFETY_PROVIDER=none           # rekognition
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Billing (high-risk processor such as CCBill / Segpay)
BILLING_WEBHOOK_SECRET=
FREE_SIGNUP_CREDITS=5
